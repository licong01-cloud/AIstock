# AI股票分析系统环境配置（示例）
# 仅包含键名与示例值，请复制为 .env 并按本机环境填写。

# ========== DeepSeek API配置 ==========
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# ========== Tushare数据接口（可选）==========
TUSHARE_TOKEN=""

# ========== TDX本地数据源（可选）==========
TDX_API_BASE="http://localhost:19080"
TDX_CLIENT_PATH=""

# ========== FastAPI backend bind configuration ==========
# Use 0.0.0.0 when remote QE workers must call back to this machine.
NEXT_APP_HOST="0.0.0.0"
NEXT_APP_PORT="8001"

# ========== Qlib / WSL / 路径配置（可选）==========
QLIB_WSL_DISTRO="Ubuntu"
QLIB_WSL_CONDA_SH="/path/to/conda.sh"
QLIB_WSL_CONDA_ENV="rdagent-gpu"
QLIB_RDAGENT_ROOT_WIN="C:/path/to/RD-Agent-main"
QLIB_RDAGENT_ROOT_WSL="/path/to/RD-Agent-main"
QLIB_SCRIPTS_SUBDIR="scripts"
QLIB_CSV_ROOT_WIN="C:/path/to/qlib_csv"
QLIB_BIN_ROOT_WIN="C:/path/to/qlib_bin"
QLIB_SNAPSHOT_ROOT="C:/path/to/qlib_snapshots"
QE_WORKSPACE_WIN="C:/path/to/RD-Agent-main/qe_workspace"
QE_WORKSPACE_WSL="/path/to/RD-Agent-main/qe_workspace"
RDAGENT_FACTOR_DATA_WSL="/path/to/RD-Agent-main/git_ignore_folder/factor_implementation_source_data"
QLIB_DATA_PATH_WSL="/path/to/qlib_bin"
QLIB_DAY_DATA="/path/to/qlib_bin"
QLIB_MINUTE_PATH_WSL="/path/to/qlib_minute_bin"
QLIB_MINUTE_DATA="/path/to/qlib_minute_bin"
RDAGENT_LOG_ROOT="/path/to/RD-Agent-main/log"
QLIB_RDAGENT_LOG_ROOT="/path/to/RD-Agent-main/log"
ANNOUNCE_PDF_ROOT="D:/AIstockDB/data/anns"

# ========== Prompt Pack 导入目录（AIstock 提示词模板管理）==========
PROMPT_PACK_INBOX_DIR="F:/Dev/AIstock/prompt_packs_inbox"

# ========== TimescaleDB数据库配置（TDX调度与数据入库）==========
TDX_DB_HOST="127.0.0.1"
TDX_DB_PORT="5432"
TDX_DB_NAME="aistock"
TDX_DB_USER="postgres"
TDX_DB_PASSWORD=""

# ========== MiniQMT量化交易配置（可选）==========
MINIQMT_ENABLED="true"
MINIQMT_ACCOUNT_ID=""
MINIQMT_MODE="SIM"
MINIQMT_USERDATA_PATH="F:/QMT_SIM/userdata_mini"
MINIQMT_SESSION_ID="123456"
MINIQMT_XTQUANT_DIR=""  # 可选：不填则默认使用 <AIstock_ROOT>/xtquant
MINIQMT_HOST="127.0.0.1"
MINIQMT_PORT="58610"

# ========== 邮件通知配置（可选）==========
EMAIL_ENABLED="false"
SMTP_SERVER="smtp.163.com"
SMTP_PORT="465"
EMAIL_FROM=""
EMAIL_PASSWORD=""
EMAIL_TO=""

# ========== Webhook通知配置（可选）==========
WEBHOOK_ENABLED="false"
WEBHOOK_TYPE="dingtalk"
WEBHOOK_URL=""
WEBHOOK_KEYWORD="aiagents通知"

# ========== 代理池与网络优化（可选）==========
USE_PROXY="false"
PROXYPOOL_ENABLED="false"
PROXYPOOL_BASE_URL=""
PROXYPOOL_AUTH_TYPE="token"
PROXYPOOL_TOKEN=""
PROXYPOOL_USERNAME=""
PROXYPOOL_PASSWORD=""
PROXY_REFRESH_INTERVAL_MIN="10"

# ========== RD-Agent Strategy Store ==========
AISTOCK_STRATEGY_STORE_ROOT="F:/Dev/AIstock_strategy_store"
RDAGENT_AISTOCK_JSON_ROOT="/path/to/RD-Agent-main/RDagentDB/aistock"

# ========== 其他配置（自动生成）==========
NEWS_INGEST_VERBOSE_LOG="true"

# ========== QuantEvolver 演进配置 ==========
QE_WEBHOOK_SECRET=""
QE_EVOLUTION_SCAN_INTERVAL_SEC="60"
DISABLE_EVOLUTION_SCANNER=""

# ========== QE remote callback configuration ==========
# AIstock FastAPI base URL reachable by WSL and remote QE workers.
# Use the LAN address when remote workers must call back into this machine.
# Example: http://192.168.50.14:8001
AISTOCK_QE_CALLBACK_BASE_URL=""
# Optional full endpoint overrides. Leave empty unless a reverse proxy/path is used.
AISTOCK_QE_LOOP_CALLBACK_URL=""
AISTOCK_QE_EVOLUTION_LOOP_CALLBACK_URL=""

# ========== GitHub Issues 集成（可选）==========
# Backend/scripts: prefer explicit service env GH_TOKEN/GITHUB_TOKEN in production.
# Local dev can use GitHub CLI keyring (`gh auth token`) plus .env.github-issues-local.
GITHUB_REPOSITORY="licong01-cloud/AIstock"
# Frontend Validation Center GitHub Issues overlay.
NEXT_PUBLIC_GITHUB_REPOSITORY="licong01-cloud/AIstock"

# ========== Research Assistant External Research (opt-in real provider) ==========
# Default stays offline/deterministic. Set provider=real only after AgentSearch is deployed.
RA_EXTERNAL_RESEARCH_PROVIDER="offline"
RA_AGENTSEARCH_BASE_URL="http://127.0.0.1:3939"
RA_PAPER_PROVIDER="semantic_scholar"
S2_API_KEY=""
