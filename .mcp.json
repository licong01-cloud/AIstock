{
  "_comment": "AIstock MCP servers use the unified gateway on local backend 8001. Prefer aistock-gateway-lite by default; enable task profiles explicitly. Legacy standalone validation/qe scripts are no longer registered here.",
  "mcpServers": {
    "aistock-gateway-lite": {
      "command": "python",
      "args": [
        "scripts/aistock_mcp_gateway.py",
        "--profile=lite"
      ],
      "env": {
        "AISTOCK_MCP_BASE_URL": "http://127.0.0.1:8001/api/v1"
      }
    },
