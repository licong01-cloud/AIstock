{
  "_comment": "Project-level MCP server registration. Servers are opt-in per developer/client. QE MCP servers default to dev backend 8011 and must stay loopback-only.",
  "mcpServers": {
    "aistock-validation": {
      "command": "python",
      "args": [
        "scripts/aistock_mcp_server.py"
      ],
      "env": {
        "AISTOCK_VALIDATION_BASE_URL": "http://127.0.0.1:8011/api/v1/validation"
      }
    },
    "aistock-qe-experiment": {
      "command": "python",
      "args": [
        "scripts/aistock_qe_experiment_mcp_server.py"
      ],
      "env": {
        "AISTOCK_QE_EXPERIMENT_BASE_URL": "http://127.0.0.1:8011/api/v1"
      }
    },
    "aistock-qe-archive": {
      "command": "python",
      "args": [
        "scripts/aistock_qe_archive_mcp_server.py"
      ],
      "env": {
        "AISTOCK_QE_ARCHIVE_BASE_URL": "http://127.0.0.1:8011/api/v1/qe-archive"
      }
    }
  }
}
