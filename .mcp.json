{
  "_comment": "项目级 MCP server 注册文件。当前按用户要求默认指向本机生产后端 8001；各客户端仍需显式启用。QE MCP 只能使用 loopback 地址。",
  "mcpServers": {
    "aistock-validation": {
      "command": "python",
      "args": [
        "scripts/aistock_mcp_server.py"
      ],
      "env": {
        "AISTOCK_VALIDATION_BASE_URL": "http://127.0.0.1:8001/api/v1/validation"
      }
    },
    "aistock-qe-experiment": {
      "command": "python",
      "args": [
        "scripts/aistock_qe_experiment_mcp_server.py"
      ],
      "env": {
        "AISTOCK_QE_EXPERIMENT_BASE_URL": "http://127.0.0.1:8001/api/v1"
      }
    },
    "aistock-qe-archive": {
      "command": "python",
      "args": [
        "scripts/aistock_qe_archive_mcp_server.py"
      ],
      "env": {
        "AISTOCK_QE_ARCHIVE_BASE_URL": "http://127.0.0.1:8001/api/v1/qe-archive"
      }
    }
  }
}
