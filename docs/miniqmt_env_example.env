# AIstock - MiniQMT / xtquant 示例环境变量（复制到项目根目录并改名为 .env）
#
# Windows 路径建议使用正斜杠 /，避免反斜杠转义问题。
# 中文目录一般可用；若遇到连接/加载异常，优先尝试将 miniQMT 安装到纯英文路径。

# 是否启用 QMT 连接能力
MINIQMT_ENABLED="true"

# QMT 资金账号（模拟盘/实盘取决于你在 miniQMT 客户端登录的账户）
MINIQMT_ACCOUNT_ID="你的资金账号"

# 模式标注：SIM=模拟盘，LIVE=实盘（用于 AIstock 侧风控/标注分流）
MINIQMT_MODE="SIM"

# miniQMT 安装目录下的 userdata_mini 路径（xtquant 交易连接必填）
# 你当前安装目录示例：F:\国金QMT交易端模拟
MINIQMT_USERDATA_PATH="F:/国金QMT交易端模拟/userdata_mini"

# xtquant 会话ID：同一台机器上多个策略/进程需要不同ID；单后端实例可用固定值
MINIQMT_SESSION_ID="123456"

# 可选：覆盖 xtquant 目录路径（默认自动使用 <AIstock_ROOT>/xtquant）
# MINIQMT_XTQUANT_DIR="F:/Dev/AIstock/xtquant"
MINIQMT_XTQUANT_DIR=""

# 兼容字段（当前直连 xtquant 模式通常不需要）
MINIQMT_HOST="127.0.0.1"
MINIQMT_PORT="58610"


