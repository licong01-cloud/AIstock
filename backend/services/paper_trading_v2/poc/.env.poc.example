# PoC env override template. Copy to .env.poc and fill in real values.
# .env.poc is gitignored; this .example is committed.
# Loaded by poc/_common.py via: load_dotenv(".env.poc", override=True)
#
# Reason for override layer: the main F:\Dev\AIstock\.env is shared with production
# QMT integration. Per agent_teams_session_handoff_20260508.md §8.1, do NOT touch
# the main .env from this worktree. PoC keeps a local override here.

# ====== miniQMT connection ======
# Force-enable miniQMT in PoC even if main .env has it off.
MINIQMT_ENABLED=true

# Real broker account ID for the SIM session. Get from miniQMT client or .env on
# the host machine. Do NOT commit this value.
MINIQMT_ACCOUNT_ID=<8-digit-account-id>

# SIM or LIVE. PoC must always be SIM.
MINIQMT_MODE=SIM

# CRITICAL: this is the path miniQMT actually writes to on disk. Verify by
# inspecting the live xtdata handshake banner -- it prints the runtime userdata
# dir. The main .env in this repo currently points to F:\QMT\QMT\userdata_mini
# which is STALE; the live SIM is at F:\QMT_SIM\userdata_mini (matches
# .env.example). Use whatever the running client reports.
MINIQMT_USERDATA_PATH=F:\QMT_SIM\userdata_mini

# Pick a session ID different from any production / .env value to avoid
# `lock_down_queue_win_<id>` collisions. The repo .env uses 123456; PoC default
# 987654.
MINIQMT_SESSION_ID=987654

# Vendored xtquant directory. Default points to the in-repo bundled copy that
# matches the locally-running miniQMT client. Override only if you have a
# version-pinned xtquant elsewhere.
MINIQMT_XTQUANT_DIR=F:\Dev\AIstock\xtquant

MINIQMT_CONNECT_TIMEOUT_SECONDS=15
MINIQMT_HOST=127.0.0.1
MINIQMT_PORT=58610

# ====== PoC scenario knobs ======
# Liquid SH stock for tick + order tests. SPDB (浦发银行) is a safe default.
POC_TEST_STOCK=600000.SH

# Limit price offset (RMB) below current last price for the BUY test. Use a
# negative number large enough that the order will not fill on the live SIM
# book. -1.50 RMB below market is safe for any large-cap stock.
POC_LIMIT_PRICE_OFFSET=-1.50

# Order size for the BUY test. 100 shares = 1 lot for A-share stock.
POC_ORDER_VOLUME=100
